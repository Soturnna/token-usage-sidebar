{
  "name": "token-usage-sidebar",
  "version": "1.2.0",
  "description": "Barra lateral de desktop que mostra o consumo da API da Anthropic (Claude) nas janelas de 5h e 7 dias.",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/build-relay.js",
    "start": "electron .",
    "predist": "node scripts/build-relay.js",
    "dist": "electron-builder --win portable",
    "test": "node test/agent-state.test.js && node test/hooks-install.test.js"
  },
  "keywords": [
    "anthropic",
    "claude",
    "usage",
    "rate-limit",
    "sidebar",
    "electron"
  ],
  "author": "Marcos Júnio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.marcos.tokenusagesidebar",
    "productName": "token-usage-sidebar",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "token-usage-sidebar.exe"
    }
  }
}
